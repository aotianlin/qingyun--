/* ===== 表单页通用（批次 A-E 复用；布局细节允许页内，颜色/圆角一律走令牌） ===== */
.form-page { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: var(--bg); display: flex; flex-direction: column; }
.form-scroll { flex: 1; min-height: 0; }
.form-card { margin: 12px 16px 0; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 14px 16px; }
.form-label { font-size: 13px; font-weight: 700; color: var(--text1); margin-bottom: 8px; display: flex; justify-content: space-between; }
.form-label .cnt { color: var(--text3); font-weight: 400; font-size: 11px; }
.form-input { width: 100%; min-height: 44px; font-size: 15px; color: var(--text1); }
.form-textarea { width: 100%; min-height: 120px; font-size: 15px; line-height: 1.6; color: var(--text1); }
.form-ph { color: var(--text3); }
.form-bar { flex-shrink: 0; background: rgba(255,255,255,.97); border-top: 1px solid var(--line); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 10px; }
.form-primary { flex: 1; height: 46px; line-height: 46px; border-radius: 23px; background: var(--primary); color: #fff; font-size: 16px; font-weight: 700; text-align: center; }
.form-primary.disabled { opacity: .4; }
.form-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.form-chip { height: 30px; line-height: 30px; padding: 0 13px; border-radius: 15px; background: var(--primary-softer); color: var(--text2); font-size: 12.5px; }
.form-chip.on { background: var(--primary); color: #fff; font-weight: 600; }
.form-chip.add { background: var(--card); border: 1px dashed var(--text3); color: var(--text3); }
.img-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.img-cell { width: 96px; height: 96px; border-radius: 12px; overflow: hidden; position: relative; background: var(--primary-softer); display: flex; align-items: center; justify-content: center; }
.img-cell image { width: 100%; height: 100%; }
.img-del { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; border-radius: 50%; background: rgba(0,0,0,.5); color: #fff; font-size: 12px; display: flex; align-items: center; justify-content: center; }
.img-add { width: 96px; height: 96px; border-radius: 12px; border: 1.5px dashed var(--text3); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text3); font-size: 11px; gap: 4px; }
.seg3 { display: flex; gap: 8px; }
.seg3 .s { flex: 1; height: 36px; line-height: 36px; text-align: center; border-radius: 18px; background: var(--primary-softer); color: var(--text2); font-size: 13px; }
.seg3 .s.on { background: var(--primary); color: #fff; font-weight: 600; }
.bounty-row { display: flex; gap: 8px; }
.bounty-opt { flex: 1; height: 40px; line-height: 40px; text-align: center; border-radius: 12px; background: var(--primary-softer); color: var(--text2); font-size: 13px; }
.bounty-opt.on { background: var(--primary); color: #fff; font-weight: 700; }
.field-hint { font-size: 11px; color: var(--text3); margin-top: 6px; }

/* ===== 灵动化：按压/选中过渡（全表单页共享；只加过渡不改静态样式） ===== */
.form-card { transition: transform .12s var(--ease); }
.form-primary { transition: transform .12s var(--ease), opacity .2s var(--ease); }
.form-chip, .bounty-opt, .seg3 .s { transition: transform .12s var(--ease), background-color .15s var(--ease), color .15s var(--ease); }
