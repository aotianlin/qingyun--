@import "../../styles/form.wxss";
.lg-page { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: var(--bg); overflow-y: auto; }
.lg-brand { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-bottom: 36px; }
.lg-logo { width: 64px; height: 64px; border-radius: 20px; background: var(--primary); color: #fff; font-size: 28px; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 24px rgba(23,90,103,.3); }
.lg-title { font-size: 24px; font-weight: 800; letter-spacing: 6px; margin-left: 6px; }
.lg-slogan { font-size: 12px; color: var(--text3); }
.lg-card { margin: 0 24px; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 20px; }
.lg-tabs { display: flex; gap: 20px; margin-bottom: 18px; }
.lg-tab { font-size: 15px; color: var(--text3); padding-bottom: 4px; }
.lg-tab.on { color: var(--text1); font-weight: 800; border-bottom: 3px solid var(--primary); }
.lg-field { height: 48px; border-radius: 12px; background: var(--bg); border: 1px solid var(--line); margin-bottom: 12px; display: flex; align-items: center; padding: 0 14px; }
.lg-input { flex: 1; min-width: 0; font-size: 15px; }
.lg-code-row { padding-right: 6px; }
.lg-code-btn { flex-shrink: 0; height: 34px; line-height: 34px; padding: 0 12px; border-radius: 17px; background: var(--primary-softer); color: var(--primary-deep); font-size: 12px; font-weight: 700; }
.lg-code-btn.busy { color: var(--text3); }
.lg-aux { display: flex; justify-content: flex-end; margin: -2px 0 14px; }
.lg-submit { width: 100%; }
.lg-wx { margin: 24px 0 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.lg-wx-btn { width: 48px; height: 48px; border-radius: 50%; background: #07C160; color: #fff; font-size: 18px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.lg-agreement { text-align: center; margin: 20px 0 30px; font-size: 11px; }
