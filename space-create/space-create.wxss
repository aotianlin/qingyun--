@import "../../styles/form.wxss";
.sc-preview { margin: 16px 16px 0; height: 110px; border-radius: var(--r-lg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; color: #fff; }
.sc-ch { width: 46px; height: 46px; border-radius: 50%; background: rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 19px; font-weight: 800; }
.sc-name { font-size: 15px; font-weight: 700; }
.sc-covers { display: flex; gap: 12px; }
.sc-dot { width: 34px; height: 34px; border-radius: 50%; border: 3px solid transparent; }
.sc-dot.on { border-color: var(--text1); }
