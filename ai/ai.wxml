<view class="ai-page" style="padding-top:{{sb}}px">
  <view class="ai-head rise" style="--i:0">
    <view class="mine-back" hover-class="press-sm" bind:tap="goBack"><view class="icu-15"/></view>
    <view class="ai-badge"><view class="icu-ai {{aiFace}}"/></view>
    <view class="ai-title-wrap">
      <view class="ai-title">青云学伴</view>
      <view class="ai-sub"><view class="ai-dot"/>校园 AI 问答 · 什么都能问</view>
    </view>
  </view>
  <view class="hist-row rise" style="--i:1">
    <view class="hist" hover-class="press-sm" bind:tap="openHist" data-k="plan">上次：数据结构复习计划 ›</view>
    <view class="hist" hover-class="press-sm" bind:tap="openHist" data-k="paper">上次：文献综述降重 ›</view>
  </view>
  <scroll-view scroll-y scroll-into-view="{{scrollId}}" class="chat-msgs ai-msgs mp-scroll">
    <view class="chat-inner">
    <view wx:if="{{hints}}" class="ai-welcome">
      <view class="row ai rise" style="--i:2"><view class="row-ava"><view class="icu-ai"/></view><view class="bubble">{{greetingText}}</view></view>
      <view class="ask-list rise" style="--i:3">
        <view class="ask-head">
          <view class="icu-3 ask-spark"/>
          <text class="ask-h">今天大家都在问</text>
        </view>
        <view class="ask-item rise" style="--i:{{index + 4}}" hover-class="ask-press" wx:for="{{asks}}" wx:key="*this" bind:tap="onAskItem" data-q="{{item}}">
          <text class="ask-no">0{{index + 1}}</text>
          <text class="ask-q">{{item}}</text>
          <view class="ask-arr icu-45"/>
        </view>
      </view>
      <view class="motif-mist"/>
    </view>
    <view wx:for="{{msgs}}" wx:key="index" id="m{{index}}" class="row {{item.role === 'user' ? 'user' : 'ai'}}">
      <view wx:if="{{item.role !== 'user'}}" class="row-ava"><view class="icu-ai {{item.typing ? 'think' : ''}}"/></view>
      <view class="bubble">
        <view wx:if="{{item.typing}}" class="typing"><text class="_i"></text><text class="_i"></text><text class="_i"></text></view>
        <block wx:else>
          <text>{{item.text}}</text>
          <view wx:if="{{item.plan.length}}" class="plan">
            <view class="pv" wx:for="{{item.plan}}" wx:for-item="p" wx:key="b"><text class="_b">{{p.b}}</text><text class="_s ps">{{p.s}}</text></view>
          </view>
          <text wx:if="{{item.tail}}" class="tail">{{item.tail}}</text>
          <view wx:if="{{item.cites.length}}" class="cites">
            <view class="cite" wx:for="{{item.cites}}" wx:for-item="c" wx:key="label"><text class="fi">{{c.fi}}</text>{{c.label}}</view>
          </view>
        </block>
      </view>
      <view wx:if="{{item.role === 'user'}}" class="row-ava me" style="background:{{me.bg}};color:{{me.fg}}"><image wx:if="{{me.avatarUrl}}" class="row-ava-img" src="{{me.avatarUrl}}" mode="aspectFill"/><text wx:else>{{me.ch}}</text></view>
    </view>
    <view style="height:8rpx"></view>
    </view>
  </scroll-view>
  <view class="ai-dock" style="padding-bottom:{{kbH ? kbH + 'px' : ''}}">
    <scroll-view scroll-x class="hscroll">
      <view class="dock-chips">
        <view class="sug" hover-class="press-sm" wx:for="{{chips}}" wx:key="index" bind:tap="onChip" data-q="{{item[1]}}">{{item[0]}}</view>
      </view>
    </scroll-view>
    <view class="dock-input">
      <input class="_input {{inputFocus ? 'on' : ''}}" placeholder="问点什么…复习、论文、选课都行" value="{{input}}" bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur" confirm-type="send" bindconfirm="onSend" adjust-position="{{false}}" bindkeyboardheightchange="onKb" />
      <view class="send" hover-class="press-sm" bind:tap="onSend"><view class="icu-28"/></view>
    </view>
  </view>
</view>

<!-- 历史对话（page-container：系统返回/侧滑手势自动关闭） -->
<page-container show="{{chatOpen}}" position="bottom" overlay duration="300">
  <view class="chat-page" style="position:relative;inset:auto;transform:none;opacity:1;pointer-events:auto;display:flex;flex-direction:column;height:100vh;padding-top:{{sb}}px">
  <view class="chat-head">
    <view class="chat-back" hover-class="press-sm" bind:tap="closeHist"><view class="icu-44"/></view>
    <view><text class="_b">青云学伴</text><text class="_s">{{hist.sub}} · 可引用站内资料作答</text></view>
  </view>
  <scroll-view scroll-y scroll-into-view="{{histScrollId}}" class="chat-msgs mp-scroll">
    <view class="chat-inner">
      <view wx:for="{{histMsgs}}" wx:key="index" id="h{{index}}" class="row {{item.role === 'user' ? 'user' : 'ai'}}">
        <view wx:if="{{item.role !== 'user'}}" class="row-ava"><view class="icu-ai {{item.typing ? 'think' : ''}}"/></view>
        <view class="bubble">
          <view wx:if="{{item.typing}}" class="typing"><text class="_i"></text><text class="_i"></text><text class="_i"></text></view>
          <block wx:else>
          <text>{{item.text}}</text>
          <view wx:if="{{item.plan.length}}" class="plan">
            <view class="pv" wx:for="{{item.plan}}" wx:for-item="p" wx:key="b"><text class="_b">{{p.b}}</text><text class="_s ps">{{p.s}}</text></view>
          </view>
          <view wx:if="{{item.cites.length}}" class="cites">
            <view class="cite" wx:for="{{item.cites}}" wx:for-item="c" wx:key="label"><text class="fi">{{c.fi}}</text>{{c.label}}</view>
          </view>
          </block>
        </view>
        <view wx:if="{{item.role === 'user'}}" class="row-ava me" style="background:{{me.bg}};color:{{me.fg}}"><image wx:if="{{me.avatarUrl}}" class="row-ava-img" src="{{me.avatarUrl}}" mode="aspectFill"/><text wx:else>{{me.ch}}</text></view>
      </view>
    </view>
  </scroll-view>
  <scroll-view scroll-x class="hscroll">
    <view class="sugs">
      <view class="sug" hover-class="press-sm" wx:for="{{histSugs}}" wx:key="*this" bind:tap="histQuick" data-q="{{item}}">{{item}}</view>
    </view>
  </scroll-view>
  <view class="chat-input" style="padding-bottom:{{kbH ? kbH + 'px' : ''}}">
    <input class="_input" placeholder="{{hist.ph}}" value="{{chatInput}}" bindinput="histInput" confirm-type="send" bindconfirm="histSend" adjust-position="{{false}}" bindkeyboardheightchange="onKb" />
    <view class="send" hover-class="press-sm" bind:tap="histSend"><view class="icu-28"/></view>
  </view>
  </view>
</page-container>

<view class="toast {{toastShow ? 'show' : ''}}">{{toastMsg}}</view>
