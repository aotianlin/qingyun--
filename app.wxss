.mine-back.press-sm .icu-15,.dm-back.press-sm .icu-42,.chat-back.press-sm .icu-44{transform:translateX(-3rpx)}
@media (prefers-reduced-motion:reduce){.mine-back .icu-15,.dm-back .icu-42,.chat-back .icu-44{transition:none}}
.w-pill.dl .icu-8{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2211%22%20height%3D%2211%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%230F454F%22%20stroke-width%3D%222.6%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%204v11M7%2011l5%205%205-5M4%2020h16%22%2F%3E%3C%2Fsvg%3E")}

/* ============================================================
   Uiverse 效果移植（视觉 1:1；checkbox→点按态、hover→按压态、SVG→data-URI）
   ============================================================ */

/* 内容卡统一走纸卡 Token：磨砂只用于背后有滚动内容的悬浮件，不铺在整条信息流上 */
/* —— ①b 苔纹卡框：form-card（仅表单页保留）—— */
.form-card { background: #E2E0E0; border: 18rpx solid #E8E8E8; border-radius: 78rpx; box-shadow: rgba(50,50,93,.25) 0 100rpx 200rpx -40rpx, rgba(0,0,0,.3) 0 60rpx 120rpx -60rpx, rgba(10,37,64,.35) 0 -4rpx 12rpx 0 inset; position: relative; }
.form-card::after { content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: 60rpx; background: repeating-conic-gradient(#E8E8E8 0.0000001%, #93A1A1 0.000104%) 60% 60%/600% 600%; filter: opacity(10%) contrast(105%); }

/* —— ② 返回钮按压填充（hover→按压态：中心圆扩散、箭头反白）—— */
.mine-back::before, .dm-back::before, .chat-back::before { content: ""; position: absolute; inset: 0; margin: auto; width: 50rpx; height: 50rpx; border-radius: inherit; scale: 0; background: var(--primary); transition: all .6s cubic-bezier(.23,1,.32,1); }
.mine-back .icu-15, .dm-back .icu-42, .chat-back .icu-44 { position: relative; z-index: 1; }
.mine-back.press-sm::before, .dm-back.press-sm::before, .chat-back.press-sm::before { scale: 2.6; }
.mine-back.press-sm, .dm-back.press-sm, .chat-back.press-sm { border-color: var(--primary); box-shadow: 0 0 40rpx rgba(23,90,103,.4); }
.mine-back.press-sm .icu-15 { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2217%22%20height%3D%2217%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23FFFFFF%22%20stroke-width%3D%222.2%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M15%205l-7%207%207%207%22%2F%3E%3C%2Fsvg%3E"); }
.dm-back.press-sm .icu-42 { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2220%22%20height%3D%2220%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23FFFFFF%22%20stroke-width%3D%222.2%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M15%205l-7%207%207%207%22%2F%3E%3C%2Fsvg%3E"); }
.chat-back.press-sm .icu-44 { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2218%22%20height%3D%2218%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23FFFFFF%22%20stroke-width%3D%222.2%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M15%205l-7%207%207%207%22%2F%3E%3C%2Fsvg%3E"); }

/* —— ③ 红心点赞（Uiverse heart，红 #FF5B89；点按态复刻 :checked 分支）—— */
.heart { position: relative; width: 34rpx; height: 34rpx; transition: .3s; }
.heart.sm { width: 26rpx; height: 26rpx; }
.heart .h-o, .heart .h-f { position: absolute; inset: 0; background-position: center; background-size: contain; background-repeat: no-repeat; }
.heart .h-o { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20fill%3D%22%23FF5B89%22%20d%3D%22M17.5%201.917a6.4%206.4%200%200%200-5.5%203.3%206.4%206.4%200%200%200-5.5-3.3A6.8%206.8%200%200%200%200%208.967c0%204.547%204.786%209.513%208.8%2012.88a4.974%204.974%200%200%200%206.4%200C19.214%2018.48%2024%2013.514%2024%208.967A6.8%206.8%200%200%200%2017.5%201.917Zm-3.585%2018.4a2.973%202.973%200%200%201-3.83%200C4.947%2016.006%202%2011.87%202%208.967a4.8%204.8%200%200%201%204.5-5.05A4.8%204.8%200%200%201%2011%208.967a1%201%200%200%200%202%200%204.8%204.8%200%200%201%204.5-5.05A4.8%204.8%200%200%201%2022%208.967C22%2011.87%2019.053%2016.006%2013.915%2020.313Z%22%2F%3E%3C%2Fsvg%3E"); }
.heart .h-f { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20fill%3D%22%23FF5B89%22%20d%3D%22M17.5%201.917a6.4%206.4%200%200%200-5.5%203.3%206.4%206.4%200%200%200-5.5-3.3A6.8%206.8%200%200%200%200%208.967c0%204.547%204.786%209.513%208.8%2012.88a4.974%204.974%200%200%200%206.4%200C19.214%2018.48%2024%2013.514%2024%208.967A6.8%206.8%200%200%200%2017.5%201.917Z%22%2F%3E%3C%2Fsvg%3E"); animation: k-heart-filled 1s both; }
@keyframes k-heart-filled { 0% { transform: scale(0); } 25% { transform: scale(1.2); } 50% { transform: scale(1); filter: brightness(1.5); } }
.heart .hp { position: absolute; left: 50%; top: 50%; width: 8rpx; height: 8rpx; background: #FF5B89; opacity: 0; }
.heart.on .hp1 { animation: hb1 .5s ease-out forwards; }
.heart.on .hp2 { animation: hb2 .5s ease-out forwards; }
.heart.on .hp3 { animation: hb3 .5s ease-out forwards; }
.heart.on .hp4 { animation: hb4 .5s ease-out forwards; }
.heart.on .hp5 { animation: hb5 .5s ease-out forwards; }
.heart.on .hp6 { animation: hb6 .5s ease-out forwards; }
@keyframes hb1 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 50% { opacity: .7; } 100% { transform: translate(-30rpx,-30rpx) scale(0); opacity: 0; } }
@keyframes hb2 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 50% { opacity: .7; } 100% { transform: translate(30rpx,-30rpx) scale(0); opacity: 0; } }
@keyframes hb3 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 50% { opacity: .7; } 100% { transform: translate(-42rpx,0) scale(0); opacity: 0; } }
@keyframes hb4 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 50% { opacity: .7; } 100% { transform: translate(42rpx,0) scale(0); opacity: 0; } }
@keyframes hb5 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 50% { opacity: .7; } 100% { transform: translate(0,-42rpx) scale(0); opacity: 0; } }
@keyframes hb6 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 50% { opacity: .7; } 100% { transform: translate(0,42rpx) scale(0); opacity: 0; } }

/* —— ④ 金星收藏（Uiverse star，金 #FABE15；in/out 双向关键帧复刻）—— */
.star { position: relative; width: 40rpx; height: 40rpx; transition: transform .3s ease; }
.star .s-o, .star .s-f { position: absolute; inset: 0; background-position: center; background-size: contain; background-repeat: no-repeat; }
.star .s-o { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20fill%3D%22%23FABE15%22%20d%3D%22M12%202.5L9.45%208.5L3%209.06L7.725%2013.39L6.25%2019.82L12%2016.5L17.75%2019.82L16.275%2013.39L21%209.06L14.55%208.5L12%202.5ZM12%204.75L14%209.33L18.7%209.75L15%2013.07L16.18%2017.75L12%2015.16L7.82%2017.75L9%2013.07L5.3%209.75L10%209.33L12%204.75Z%22%2F%3E%3C%2Fsvg%3E"); transition: all .3s ease; }
.star.on .s-o { opacity: 0; }
.star .s-f { background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20fill%3D%22%23FABE15%22%20d%3D%22M12%202.5L9.45%208.5L3%209.06L7.725%2013.39L6.25%2019.82L12%2016.5L17.75%2019.82L16.275%2013.39L21%209.06L14.55%208.5L12%202.5Z%22%2F%3E%3C%2Fsvg%3E"); opacity: 0; transform: scale(0); }
.star .s-f.in { animation: k-star-filled 1s both; }
.star .s-f.out { animation: k-star-unfilled .3s forwards; }
@keyframes k-star-filled { 0% { transform: scale(0); opacity: 0; } 25% { transform: scale(1.2); opacity: 1; } 50% { transform: scale(1); filter: brightness(1.5); } }
@keyframes k-star-unfilled { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(0); opacity: 0; } }
.star .sp { position: absolute; left: 50%; top: 50%; width: 8rpx; height: 8rpx; border-radius: 50%; background: #FABE15; }
.star.on .sp1 { animation: sp1 1s cubic-bezier(.25,.1,.25,1) forwards; }
.star.on .sp2 { animation: sp2 1s ease-out forwards; }
.star.on .sp3 { animation: sp3 1s ease-out forwards; }
.star.on .sp4 { animation: sp4 1s ease-out forwards; }
.star.on .sp5 { animation: sp5 1s ease-out forwards; }
.star.on .sp6 { animation: sp6 1s ease-out forwards; }
.star.on .sp7 { animation: sp7 1s ease-out forwards; }
.star.on .sp8 { animation: sp8 1s ease-out forwards; }
@keyframes sp1 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 40% { transform: translate(-30rpx,-38rpx) scale(.6); opacity: .6; } 100% { transform: translate(-60rpx,60rpx) scale(0); opacity: 0; } }
@keyframes sp2 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 40% { transform: translate(30rpx,-38rpx) scale(.6); opacity: .6; } 100% { transform: translate(60rpx,60rpx) scale(0); opacity: 0; } }
@keyframes sp3 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 40% { transform: translate(-45rpx,-30rpx) scale(.6); opacity: .6; } 100% { transform: translate(-75rpx,68rpx) scale(0); opacity: 0; } }
@keyframes sp4 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 40% { transform: translate(45rpx,-30rpx) scale(.6); opacity: .6; } 100% { transform: translate(75rpx,68rpx) scale(0); opacity: 0; } }
@keyframes sp5 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 45% { transform: translate(0,-45rpx) scale(.6); opacity: .6; } 100% { transform: translate(0,60rpx) scale(0); opacity: 0; } }
@keyframes sp6 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 35% { transform: translate(-52rpx,-22rpx) scale(.6); opacity: .6; } 100% { transform: translate(-90rpx,75rpx) scale(0); opacity: 0; } }
@keyframes sp7 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 35% { transform: translate(52rpx,-22rpx) scale(.6); opacity: .6; } 100% { transform: translate(90rpx,75rpx) scale(0); opacity: 0; } }
@keyframes sp8 { 0% { transform: translate(0,0) scale(1); opacity: 1; } 45% { transform: translate(0,-52rpx) scale(.6); opacity: .6; } 100% { transform: translate(0,68rpx) scale(0); opacity: 0; } }

/* —— ⑤ FAB：保留光池、凸起和品牌阴影；按用户偏好保留 5s 呼吸闪烁，按压只走 press-fab 的缩放 —— */
.fab-btn .icu-31 { animation: fab-flicker 5s linear infinite; animation-delay: .5s; filter: drop-shadow(0 0 4rpx rgba(255, 255, 255, .6)); }
@keyframes fab-flicker { 50% { opacity: .3; } }

/* —— ⑥ Nebula 搜索框（纸底大圆角药丸 + 紫辉光聚焦 + 浮动标签 + 星云粒子，:focus→.on 聚焦态）—— */
.nebula { position: relative; flex: 1; min-width: 0; }
.nebula .nb-in { width: 100%; height: 88rpx; padding: 0 30rpx; border: 2.5rpx solid rgba(23,90,103,.35); background: var(--card); color: var(--text1); font-size: 32rpx; border-radius: var(--r-full); box-shadow: 0 4rpx 12rpx -6rpx rgba(15,69,79,.3); transition: border-color .2s var(--ease), box-shadow .25s var(--ease), background-color .25s var(--ease); box-sizing: border-box; }
.nebula .nb-ph { color: transparent; }
.nebula .nb-label { position: absolute; left: 30rpx; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--text-meta); background: var(--card); padding: 0 10rpx; font-size: 32rpx; transition: transform .3s var(--ease), font-size .3s var(--ease), color .2s var(--ease), left .3s var(--ease); max-width: 80%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nebula.on .nb-in { border-color: rgba(139,92,246,.72); box-shadow: 0 8rpx 18rpx -12rpx rgba(107,70,193,.35); }
.nebula.on .nb-label { transform: translateY(-78rpx); font-size: 24rpx; color: #6B46C1; left: 20rpx; }
.nebula .nb-p { position: absolute; width: 12rpx; height: 12rpx; border-radius: 50%; pointer-events: none; opacity: 0; top: 50%; left: 20rpx; filter: blur(1.6rpx); transition: opacity .3s ease; }
.nebula.on .nb-p { animation: nebula-float 2s forwards ease-out; }
@keyframes nebula-float { 0% { transform: translate(0,-50%) scale(.8); opacity: 0; background: #C774FF; } 20% { opacity: .8; } 100% { transform: translate(calc(var(--x) * 280rpx), calc(var(--y) * 70rpx)) scale(1.1); opacity: 0; background: #6DF2FF; } }
.nb-static { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.nb-static .nb-label { position: static; transform: none; background: transparent; padding: 0; flex: 1; min-width: 0; }
.nb-go { flex-shrink: 0; font-size: 26rpx; color: var(--primary-deep); font-weight: 600; letter-spacing: 1rpx; }

@media (prefers-reduced-motion: reduce) {
  .fab-btn .icu-31, .heart .h-f, .heart .hp, .star .s-f, .star .sp, .nebula .nb-p { animation: none !important; }
  .tabbar, .sheet, .mask, .sd-panel, .sd-mask, .detail, .fab-btn, .ai-strip, .itab, .tab { transition: none !important; }
}
/* 搜索下拉：玻璃弹窗（四页共用：向下弹出，热门搜索 chips）
   镂空方式：遮罩恒定铺满全屏（含状态栏/大标题/工具条），只有「搜索框 + 弹窗」靠 z 序浮在其上；
   绝不能用 top 偏移让遮罩从弹窗顶部才起算——那样标题区会整体漏光，等于没遮 */
.sd-mask { position: fixed; inset: 0; background: rgba(23,43,35,.24); opacity: 0; pointer-events: none; transition: opacity .25s var(--ease); z-index: 88; }
.sd-mask.show { opacity: 1; pointer-events: auto; }
/* 搜索框宿主行（承载 .nebula 的那一层）：.rise 的 fill:both 会让动画终帧的 transform 常驻，
   留下一个合成层 —— 搜索框的 z-index:89 就被困在宿主内部，遮罩会反过来把它盖住。
   这里只改填充模式为 backwards：终帧与自然态等价（opacity:1 / transform:none），视觉不变，
   但动画结束后不再残留合成层，同时也不会像 both 那样一直压住 .nav-hide 之类的 transform。 */
.sd-host { animation-fill-mode: backwards; }
.sd-panel { position: fixed; left: 24rpx; right: 24rpx; z-index: 89; background: rgba(255,255,255,.62); -webkit-backdrop-filter: blur(40rpx) saturate(1.25); backdrop-filter: blur(40rpx) saturate(1.25); border-radius: var(--r-xl); border: 1rpx solid rgba(255,255,255,.65); box-shadow: var(--shadow-2); padding: 24rpx; opacity: 0; transform: translateY(-16rpx); pointer-events: none; transition: opacity .26s var(--ease), transform .26s var(--ease); }
.sd-panel.show { opacity: 1; transform: none; pointer-events: auto; }
.sd-hd { display: flex; align-items: baseline; justify-content: space-between; margin: 26rpx 6rpx 18rpx; }
.sd-hd ._s { font-size: 22rpx; color: var(--text-meta); letter-spacing: .5rpx; }
.sd-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sd-chip { height: 60rpx; line-height: 60rpx; padding: 0 24rpx; border-radius: var(--r-full); background: rgba(255,255,255,.65); border: 1rpx solid rgba(255,255,255,.7); font-size: 24rpx; color: var(--text-meta); -webkit-backdrop-filter: blur(20rpx); backdrop-filter: blur(20rpx); }
/* 打开态：动效输入框原地替换原搜索条（同一槽位，不新增）；
   提到遮罩之上(z 89)并给与弹窗同款玻璃质感，避免被墨色遮罩盖暗 */
.nb-live { display: flex; align-items: center; gap: 16rpx; position: relative; z-index: 89; }
/* 底白 .70：输入框已压在遮罩之上，透过来的底色是「纸底 × .24 墨」，
   低透明度会让药丸整体发灰（实测 .55 → 亮度掉到 ~222）；调到 .70 后与弹窗玻璃同一亮度档（~233） */
.nb-live .nb-in { flex: 1; min-width: 0; background: rgba(255,255,255,.70); -webkit-backdrop-filter: blur(30rpx) saturate(1.2); backdrop-filter: blur(30rpx) saturate(1.2); border-color: rgba(255,255,255,.75); box-shadow: 0 4rpx 12rpx -6rpx rgba(15,69,79,.25); }
.nb-ph2 { color: var(--text-meta); opacity: .9; }
/* 原地搜索结果（弹窗内） */
.sd-scroll { max-height: 52vh; }
.sd-sec { margin-top: 4rpx; }
.sd-sec-t { font-size: 22rpx; color: var(--text-meta); letter-spacing: 1rpx; margin: 18rpx 6rpx 10rpx; }
.sd-r { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 8rpx; border-bottom: 1rpx solid rgba(18,51,59,.06); }
.sd-r:last-child { border-bottom: none; }
.sd-r-th { width: 64rpx; height: 64rpx; border-radius: var(--r-md); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; }
.sd-r-t { font-size: 26rpx; color: var(--text1); }
.sd-r-m { font-size: 22rpx; color: var(--text-meta); margin-top: 2rpx; }
.sd-empty { padding: 48rpx 0 24rpx; text-align: center; font-size: 24rpx; color: var(--text-meta); }
