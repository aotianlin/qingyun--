/* ===== 发现页作用域：只覆盖本页，避免污染其他复用同名类的页面 ===== */

/* 频道筛选：原型 JS display:none 的等价实现（CSS 多列自动回流） */
.discover-page .falls.hide-photo .fcard.photo { display: none; }
.discover-page .falls.hide-qa .fcard.qa { display: none; }
.discover-page .falls.hide-doc .fcard.doc { display: none; }
.discover-page .falls.hide-chk .fcard.chk { display: none; }

/* 首屏纵向节奏：保留标题、搜索、AI、频道顺序和全部触控区，只压缩 AI 的内外留白 */
.discover-page .greet-title { margin-top: 0; }
.discover-page .head-tools { margin-top: 12rpx; }
.discover-page .ai-strip {
  margin: 20rpx 32rpx 8rpx;
  padding: 20rpx 28rpx 24rpx;
}
.discover-page .ai-prompt {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.discover-page .falls { padding-top: 16rpx; }

/* 内容卡回到纸卡：编辑式信息流靠留白与阴影分层，不靠整卡玻璃 */
.discover-page .fcard {
  background: var(--card);
  border: 0;
  border-radius: var(--r-xl);
  box-shadow: var(--shadow-2);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  transition: transform .18s var(--ease), box-shadow .18s var(--ease);
}
.discover-page .fcard.card-press {
  transform: scale(.97);
}
.discover-page .fcard.wide { margin-top: 0; }

/* 渐变封面保留方向，缩短占位面积并压低饱和度与云纹强度 */
.discover-page .gcover::after { opacity: .5; }
.discover-page .cv-sunset { background-image: linear-gradient(158deg, #F6E7D2 0%, #E8C6AB 46%, #D9A286 100%); }
.discover-page .cv-library { background-image: linear-gradient(158deg, #E4EFF3 0%, #C2D9E1 48%, #9CBBC8 100%); }
.discover-page .cv-ginkgo { background-image: linear-gradient(158deg, #F5EBCF 0%, #E4D29C 52%, #CDB579 100%); }
.discover-page .cv-algo { background-image: linear-gradient(158deg, #E2EDE5 0%, #C4D8C8 50%, #9BB6A4 100%); }

/* 药丸只承担导航提示，字号抬到辅助文字可读档 */
.discover-page .w-pill {
  height: auto;
  min-height: 48rpx;
  padding: 6rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
}
.discover-page .qtag { font-size: 22rpx; }

/* 频道结果反馈：只给筛选后的当前频道显示数量，不新增整行说明 */
.discover-page .itab {
  height: auto;
  min-height: 80rpx;
  padding: 16rpx 0 12rpx;
}
.discover-page .itab-count {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--primary-deep);
  letter-spacing: 0;
}
/* 搜索条用最小高度承载放大字体，不写死文本裁剪盒 */
.discover-page .nebula .nb-in {
  height: auto;
  min-height: 88rpx;
}

/* 扩大点击盒，不放大视觉图形；相邻热区保持间隙 */
.discover-page .avatar-btn::before {
  content: "";
  position: absolute;
  inset: -4rpx;
  border-radius: inherit;
}
.discover-page .itab::before {
  content: "";
  position: absolute;
  top: -8rpx;
  bottom: -8rpx;
  left: -16rpx;
  right: -16rpx;
}
.discover-page .nb-go {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 88rpx;
}
.discover-page .nb-cancel {
  position: relative;
  z-index: 89;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-deep);
}
.discover-page .sd-chips { row-gap: 32rpx; }
.discover-page .sd-chip {
  position: relative;
}
.discover-page .sd-chip::before {
  content: "";
  position: absolute;
  inset: -14rpx -8rpx;
}
.discover-page .sd-r { min-height: 88rpx; }
.discover-page .sd-hd { align-items: center; }
.discover-page .sd-hd-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.discover-page .sd-clear {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -16rpx 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary-deep);
}

/* 无结果兜底：不使用大面积空卡，保留可恢复入口 */
.discover-page .feed-empty {
  column-span: all;
  margin: 8rpx 0 24rpx;
  padding: 56rpx 32rpx;
  border-radius: var(--r-xl);
  background: rgba(255,255,255,.58);
  border: 1rpx solid rgba(255,255,255,.72);
  text-align: center;
}
.discover-page .feed-empty-t {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text2);
}
.discover-page .feed-empty-s {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-meta);
}
.discover-page .feed-empty-act {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  border-radius: var(--r-full);
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 320px 小屏保护：双列读不清时降为单列，不靠缩字硬保密度 */
@media (max-width: 320px) {
  .discover-page .falls { column-count: 1; }
  .discover-page .fcard.photo .gcover { height: 320rpx !important; }
}

/* 留白、缩放和过场都尊重系统减弱动态效果 */
@media (prefers-reduced-motion: reduce) {
  .discover-page .fcard,
  .discover-page .card-press,
  .discover-page .ai-strip,
  .discover-page .itab,
  .discover-page .nb-in,
  .discover-page .nb-label {
    transition: none !important;
  }
  .discover-page .fcard.card-press { transform: none; }
}
