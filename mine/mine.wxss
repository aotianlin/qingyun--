.mine-page { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: var(--bg); z-index: 60; overflow-y: auto; padding-top: env(safe-area-inset-top); }
.mine-nav { padding-top: 37rpx; }
.hh { display: flex; justify-content: space-between; align-items: baseline; }
.hh1 { font-size: 26rpx; font-weight: 700; }
.idname { font-size: 36rpx; font-weight: 800; color: #fff; }

/* 编辑资料 / 主页背景 */
.idcard-bgimg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .88; }
.id-edit { position: absolute; top: 12px; right: 12px; z-index: 5; height: 48rpx; line-height: 48rpx; padding: 0 22rpx; border-radius: 24rpx; background: rgba(255,255,255,.2); color: #fff; font-size: 20rpx; font-weight: 600; }
.bigava { position: relative; overflow: hidden; }
.bigava-img { position: absolute; inset: 0; width: 100%; height: 100%; }
