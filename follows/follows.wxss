.fw-name { display: flex; align-items: center; gap: 6px; }
.fw-mutual { font-size: 10px; color: var(--text3); background: var(--bg); padding: 1px 6px; border-radius: 5px; }
.fw-btn { flex-shrink: 0; height: 30px; line-height: 30px; padding: 0 14px; border-radius: 15px; background: var(--primary); color: #fff; font-size: 12.5px; font-weight: 700; }
.fw-btn.on { background: var(--primary-softer); color: var(--text3); font-weight: 400; }
